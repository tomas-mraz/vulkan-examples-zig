#version 460
#extension GL_EXT_ray_tracing : enable
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : enable

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0) uniform image2D image;
layout(binding = 2, set = 0) uniform CameraProperties
{
	mat4 viewInverse;
	mat4 projInverse;
	uint frame;
} cam;

#include "payload.glsl"
#include "random.glsl"

layout(location = 0) rayPayloadEXT Payload payload;

vec3 traceShaded(vec3 origin, vec3 direction, float tmin, float tmax, uint seed, uint flags)
{
	payload.radiance = vec3(1.0);
	payload.seed = seed;
	payload.glassCoverage = 0.0;
	payload.glassFirstT = -1.0;
	payload.glassFirstNormal = vec3(0.0);
	payload.flags = flags;
	traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT, 0xff, 0, 0, 0, origin, tmin, direction, tmax, 0);
	return payload.radiance * mix(vec3(1.0), GLASS_TINT, payload.glassCoverage);
}

void main()
{
	uint seed = tea(gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x, cam.frame);

	float r1 = rnd(seed);
	float r2 = rnd(seed);

	// Subpixel jitter for antialiasing.
	vec2 subpixel_jitter = cam.frame == 0 ? vec2(0.5f, 0.5f) : vec2(r1, r2);
	const vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + subpixel_jitter;
	const vec2 inUV        = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
	vec2       d           = inUV * 2.0 - 1.0;

	vec4 origin = cam.viewInverse * vec4(0,0,0,1);
	vec4 target = cam.projInverse * vec4(d.x, d.y, 1, 1);
	vec4 direction = cam.viewInverse * vec4(normalize(target.xyz), 0.0);

	float tmin = 0.001;
	float tmax = 10000.0;

	vec3 hitValues = vec3(0);

	const int samples = 4;

	for (int smpl = 0; smpl < samples; smpl++) {
		uint sampleSeed = tea(gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x, cam.frame + uint(smpl) * 1664525u);

		// Primary ray: gathers radiance behind glass + records nearest glass surface (T, N).
		vec3 transmitted = traceShaded(origin.xyz, direction.xyz, tmin, tmax, sampleSeed, 0u);
		float glassT = payload.glassFirstT;
		vec3  glassN = payload.glassFirstNormal;

		vec3 sampleColor = transmitted;

		if (glassT > 0.0) {
			// Make the glass normal face the incoming ray.
			vec3 N = glassN;
			if (dot(N, direction.xyz) > 0.0) N = -N;

			vec3 hitPos = origin.xyz + direction.xyz * glassT;
			vec3 R = reflect(direction.xyz, N);
			float cosTheta = max(0.0, -dot(direction.xyz, N));

			// Schlick Fresnel.
			float fresnel = GLASS_F0 + (1.0 - GLASS_F0) * pow(1.0 - cosTheta, 5.0);

			// Reflection ray (skips glass-recording so we don't recurse on glass-on-glass;
			// the REFLECTION flag tells the miss shader to produce a procedural sky).
			vec3 reflColor = traceShaded(hitPos + N * 0.001, R, 0.001, tmax, sampleSeed, PAYLOAD_FLAG_SKIP_GLASS_RECORD | PAYLOAD_FLAG_REFLECTION);

			// Sharp Phong glint from a fixed key light — gives the visor a clearly visible
			// "shiny" highlight on top of the (subtle) environment reflection.
			float spec = pow(max(0.0, dot(R, GLASS_LIGHT_DIR)), GLASS_SHININESS);
			vec3 glint = vec3(GLASS_GLINT_INTENSITY) * spec;

			sampleColor = mix(transmitted, reflColor, fresnel) + glint;
		}

		hitValues += sampleColor;
	}

	vec3 hitVal = hitValues / float(samples);

	imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(hitVal, 1.f));
}
